{
  // =============================================================================
  // Dev Container + Claude Code: Best Practices Template
  // =============================================================================
  // A hardened dev container incorporating security patterns from:
  //   - Anthropic's official reference container
  //   - Trail of Bits' claude-code-devcontainer (read-only mounts, NPM hardening)
  //   - FoamoftheSea's claude-code-sandbox (resource limits, cap-drop)
  //   - Real-world production setups (DNS/TCP fixes, scoped sudoers, DX tooling)
  //
  // Getting started: https://code.claude.com/docs/en/devcontainer
  // =============================================================================

  "name": "Secure Claude Code Workspace",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      // Pin Claude Code version for reproducible builds.
      // Set to "latest" to always get the newest release.
      "CLAUDE_CODE_VERSION": "latest",

      // Pass host timezone into the container.
      "TZ": "${localEnv:TZ:UTC}",

      // DX tooling versions — pin for reproducible builds.
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },

  // ---------------------------------------------------------------------------
  // Security: run as non-root user
  // ---------------------------------------------------------------------------
  // Claude Code rejects --dangerously-skip-permissions when run as root.
  // Always set remoteUser to a non-root account.
  "remoteUser": "developer",

  // ---------------------------------------------------------------------------
  // Capabilities: drop all, add back only the minimal set required
  // ---------------------------------------------------------------------------
  // Inspired by centminmod/claude-code-devcontainers (cap-drop ALL pattern).
  //
  // --cap-drop=ALL empties the capability bounding set, so we add back ONLY
  // what the container actually needs at runtime:
  //
  //   SETUID + SETGID      Required by sudo. sudo is setuid-root, but under
  //                        cap-drop=ALL the kernel grants an exec'd setuid
  //                        binary only the capabilities still in the bounding
  //                        set. Without these, sudo cannot setuid(0)/setgid(0)
  //                        and dies with "unable to change to root gid:
  //                        Operation not permitted" — which breaks
  //                        postStartCommand (init-firewall.sh runs via sudo).
  //   NET_ADMIN + NET_RAW  Required by init-firewall.sh (iptables / ipset).
  //                        Remove them if you rely on external network controls
  //                        (and drop postStartCommand + SETUID/SETGID too).
  //
  // Root access stays gated by scoped sudoers (only init-firewall.sh may run
  // as root). The base image does ship other setuid-root binaries (su, mount,
  // passwd, …), but they stay neutralized: a process that reaches uid 0 is
  // still capped by the bounding set (no CAP_SYS_ADMIN/DAC_OVERRIDE, so mount
  // fails), and root's password is locked (so su/newgrp fail). SETUID/SETGID
  // are needed ONLY so sudo can setuid(0)/setgid(0) to run that one script.
  //
  // IMPORTANT: Do NOT add SYS_ADMIN — it defeats read-only mount protections.
  // See: trailofbits/claude-code-devcontainer check_no_sys_admin()
  //
  // NOTE on no-new-privileges: we intentionally do NOT set it, because it
  // blocks setuid escalation and would stop sudo dead. The privilege boundary
  // here is cap-drop=ALL + minimal cap-add + scoped sudoers instead.
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--pids-limit=256",
    "--memory=8g",

    // File descriptor limits — prevents exhaustion attacks.
    "--ulimit=nofile=1024:4096",
    // Disable core dumps — prevents secrets from leaking to disk.
    "--ulimit=core=0",

    // Disable IPv6 — prevents bypassing IPv4 firewall rules entirely.
    "--sysctl=net.ipv6.conf.all.disable_ipv6=1"
  ],

  // ---------------------------------------------------------------------------
  // Workspace mount
  // ---------------------------------------------------------------------------
  // Claude Code can only modify files within /workspace (the bind mount).
  // It cannot reach host system files, adjacent projects, or home directory.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  // ---------------------------------------------------------------------------
  // Persistent volumes + read-only host mounts
  // ---------------------------------------------------------------------------
  // Persist Claude Code auth, settings, and session history across rebuilds.
  // ${devcontainerId} isolates state per-project so different repos don't clash.
  //
  // .devcontainer is mounted read-only so Claude cannot modify its own sandbox
  // config from inside the container. Pattern from trailofbits.
  //
  // .git/hooks and .claude/settings.json are protected via managed-settings.json
  // deny rules rather than read-only mounts (Edit rules are enforced even if
  // the filesystem allows writes).
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/developer/.claude,type=volume",
    "source=claude-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",

    // Persist bun's global cache and node_modules across rebuilds.
    // Uses Docker volumes so installs survive container recreation.
    //
    // Ownership: when a named volume is empty, Docker initializes it from the
    // image's directory at the mount target — copying that directory's owner.
    // The Dockerfile pre-creates /home/developer/.bun and /workspace/node_modules
    // owned by "developer", so both volumes come up writable by the non-root
    // user with NO runtime chown / sudo needed. If you add another volume,
    // create + chown its target dir in the Dockerfile the same way.
    //
    // NOTE: this only initializes EMPTY volumes. If you're upgrading a project
    // whose volumes already exist root-owned (from an older template version),
    // reset them once: docker volume rm claude-nodemodules-<id> claude-bunstore-<id>.
    "source=claude-bunstore-${devcontainerId},target=/home/developer/.bun,type=volume",
    "source=claude-nodemodules-${devcontainerId},target=/workspace/node_modules,type=volume"
  ],

  // ---------------------------------------------------------------------------
  // Container environment variables
  // ---------------------------------------------------------------------------
  "containerEnv": {
    // Point Claude Code to the persisted config volume.
    "CLAUDE_CONFIG_DIR": "/home/developer/.claude",

    // Disable auto-updater for version-pinned builds.
    // Remove this line if CLAUDE_CODE_VERSION is "latest" and you want updates.
    "DISABLE_AUTOUPDATER": "1",

    // Optional: disable telemetry and error reporting for air-gapped or
    // privacy-sensitive environments.
    // "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",

    // ---------------------------------------------------------------------------
    // Bun supply chain hardening
    // ---------------------------------------------------------------------------
    // Bun ignores lifecycle scripts by default (unlike npm), providing
    // built-in supply chain protection. No additional env vars needed.
    // See: https://bun.sh/docs/cli/install#lifecycle-scripts
    //
    // To explicitly allow scripts for trusted packages:
    //   bun install --trust @anthropic-ai/claude-code
    //
    // BUN_INSTALL points to ~/.bun for global package cache (volume-mounted
    // for persistence). The bun binary itself lives in /usr/local/bin to
    // avoid being clobbered by the empty volume on first create.
    // See: https://github.com/decebal/devcontainers-best-practices/issues/2
    "BUN_INSTALL": "/home/developer/.bun"
  },

  // ---------------------------------------------------------------------------
  // Editor customizations (VS Code / Cursor)
  // ---------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
        // Add your team's standard extensions below:
        // "dbaeumer.vscode-eslint",
        // "esbenp.prettier-vscode",
        // "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Resource requirements (optional, for Codespaces)
  // ---------------------------------------------------------------------------
  // Inspired by centminmod/claude-code-devcontainers.
  // Ensures the container gets enough resources for Claude Code.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  // ---------------------------------------------------------------------------
  // Lifecycle commands
  // ---------------------------------------------------------------------------
  // No postCreateCommand: volume ownership is handled at build time (the
  // Dockerfile pre-creates the mount-point dirs owned by "developer", and
  // Docker copies that ownership into the empty named volumes on first mount).
  //
  // postStartCommand: runs every time the container starts.
  // Start the egress firewall. Remove this if you don't use the firewall script.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
